#!/bin/bash

err="ERROR: Input expected"

# read inputs
read -r line
arg1=$1

# test for data, use active input to set url
[[ -z "$line" && -n "$arg1" ]] && url="${arg1,,}"
[[ -n "$line" && -z "$arg1" ]] && url="${line,,}" 

# exit gracefully if no input
[[ -z "$line" && -z "arg1" ]] && echo "$err" && exit 2


# filter input
title="${url#*//}"
title1="${title%%/*}"

# write stdout
echo "[${title1}](${url})"

